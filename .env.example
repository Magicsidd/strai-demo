# Kopier til .env og fyll inn. .env sjekkes aldri inn.

# Odoo. Standard er mock-Odoo på 127.0.0.1:8069 med db strai, demo@strai.no / demo.
ODOO_URL=
ODOO_DB=
ODOO_USER=
# Passord eller API-nøkkel (Innstillinger > Brukere > Kontosikkerhet > API-nøkler)
ODOO_PASSWORD=

# AI: auto | anthropic | claude_cli | regelbasert
AI_BACKEND=
# Settes for å bruke Anthropic API med bilder. Uten nøkkel brukes `claude -p`.
ANTHROPIC_API_KEY=
# Standard er claude-sonnet-5-5
AI_MODEL=

# Ordre og levering kan bruke en annen Odoo enn innboksen (Helpdesk krever Enterprise).
# Lokal Odoo 18 Community: ./scripts/odoo_lokalt.sh installer, så start. Tomme verdier gir mock.
ORDRE_ODOO_URL=
ORDRE_ODOO_DB=
ORDRE_ODOO_USER=
ORDRE_ODOO_PASSWORD=
